{
  "skipDangerousModePermissionPrompt": true,
  "permissions": {
    "deny": [
      "Read(/workspaces/devcon/claude-limit-watcher/.env.local)",
      "Bash(cat /workspaces/devcon/claude-limit-watcher/.env.local)",
      "Bash(cat .env.local)",
      "Bash(less /workspaces/devcon/claude-limit-watcher/.env.local)",
      "Bash(less .env.local)",
      "Bash(more /workspaces/devcon/claude-limit-watcher/.env.local)",
      "Bash(more .env.local)",
      "Bash(head /workspaces/devcon/claude-limit-watcher/.env.local)",
      "Bash(head .env.local)",
      "Bash(tail /workspaces/devcon/claude-limit-watcher/.env.local)",
      "Bash(tail .env.local)",
      "Read(/workspaces/devcon/trend-watcher/.env.local)",
      "Bash(cat /workspaces/devcon/trend-watcher/.env.local)",
      "Bash(less /workspaces/devcon/trend-watcher/.env.local)",
      "Bash(more /workspaces/devcon/trend-watcher/.env.local)",
      "Bash(head /workspaces/devcon/trend-watcher/.env.local)",
      "Bash(tail /workspaces/devcon/trend-watcher/.env.local)"
    ],
    "defaultMode": "bypassPermissions"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Read|Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "/workspaces/devcon/.claude/hooks/protect-env.sh"
          }
        ]
      }
    ]
  }
}
